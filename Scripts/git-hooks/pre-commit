#!/bin/bash
set -euo pipefail

staged() { git diff --cached --name-only -z --diff-filter=ACMR -- '*.swift'; }

[ -n "$(staged | tr -d '\0')" ] || exit 0

for tool in swiftlint swiftformat; do
    command -v "$tool" >/dev/null || { echo "error: $tool 이 없습니다 (brew bundle)" >&2; exit 1; }
done

staged | xargs -0 swiftlint lint --strict --quiet
staged | xargs -0 swiftformat --lint --quiet
